+/* Barrel-shifter carry for logical flag-setting instructions. Arithmetic
+ * instructions use the non-mutating arm_lsl/lsr/asr/ROR32 helpers instead:
+ * ADC/SBC consume the incoming carry, not the shifter's outgoing carry.
+ * Amounts here are decoded immediates or the low eight register bits. */
+static inline u32 arm_lsl_c(u32 value, u32 amount) {
+    if (!amount) return value;
+    if (amount < 32) {
+        CPU_C = ((value >> (32 - amount)) & 1u) != 0;
+        return value << amount;
+    }
+    CPU_C = amount == 32 && (value & 1u);
+    return 0;
+}
+static inline u32 arm_lsr_c(u32 value, u32 amount) {
+    if (!amount) return value;
+    if (amount < 32) {
+        CPU_C = ((value >> (amount - 1)) & 1u) != 0;
+        return value >> amount;
+    }
+    CPU_C = amount == 32 && (value >> 31);
+    return 0;
+}
+static inline u32 arm_asr_c(u32 value, u32 amount) {
+    if (!amount) return value;
+    if (amount < 32) {
+        CPU_C = ((value >> (amount - 1)) & 1u) != 0;
+        return (u32)((s32)value >> amount);
+    }
+    CPU_C = (value >> 31) != 0;
+    return CPU_C ? 0xFFFFFFFFu : 0;
+}
+static inline u32 arm_ror_c(u32 value, u32 amount) {
+    if (!amount) return value;
+    u32 result = ROR32(value, amount);
+    CPU_C = (result >> 31) != 0;
+    return result;
+}
+static inline u32 arm_rrx_c(u32 value) {
+    u32 result = RRX(value);
+    CPU_C = (value & 1u) != 0;
+    return result;
+}
+static inline u32 arm_imm_c(u32 value) {
+    CPU_C = (value >> 31) != 0;
+    return value;
+}
